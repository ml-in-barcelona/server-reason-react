; The React submodule is huge (it has its own ~1300-package node_modules), so keep it
; out of dune's source scan. dist/ is React's own build output for its unpublished
; `react-client` package, generated by `make react-client-generate` and committed, so building
; server-reason-react needs neither Node nor the submodule — only regeneration does.
;
; dist/ is installed as a package directory, the same way esbuild-plugin/plugin.mjs is
; installed, so consumers depend on it as
;   "@ml-in-barcelona/react-client": "file:<switch>/lib/server-reason-react/react-client"
; and their bundler resolves the bare specifier in ReactServerDOMEsbuild.js to exactly one
; copy. This must stay the ONLY copy: two resolvable paths means two Flight client instances
; with separate server-reference state.
;
; It is deliberately NOT bundled into a single file — flight.js switches on
; process.env.NODE_ENV, so the consumer's bundler picks the development or the production
; build (63KB vs 158KB) and drops the other.

(dirs :standard \ react)

(install
 (section lib)
 (package server-reason-react)
 (files
  (dist/package.json as react-client/package.json)
  (dist/flight.js as react-client/flight.js)
  (dist/LICENSE as react-client/LICENSE)
  (dist/README.md as react-client/README.md)
  (dist/cjs/react-client-flight.development.js
   as
   react-client/cjs/react-client-flight.development.js)
  (dist/cjs/react-client-flight.production.js
   as
   react-client/cjs/react-client-flight.production.js)))
