(rule
 (alias runtest)
 (deps
  (alias melange)
  (source_tree ../../../../demo/client/node_modules/react)
  (:test
   test_router_browser/packages/router/test/browser/TestRouterBrowser.js))
 (action
  (setenv
   NODE_PATH
   %{workspace_root}/demo/client/node_modules
   (run node %{test}))))

