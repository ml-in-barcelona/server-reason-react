(rule
 (targets Router.ml RouterRegistry.ml)
 (deps RouterDefinition.ml)
 (action
  (progn
   (with-stdout-to
    Router.ml
    (with-stdin-from
     RouterDefinition.ml
     (run
      %{bin:server-reason-react.router-gen}
      --mode
      handles
      --source
      RouterDefinition.ml)))
   (with-stdout-to
    RouterRegistry.ml
    (with-stdin-from
     RouterDefinition.ml
     (run
      %{bin:server-reason-react.router-gen}
      --mode
      registry
      --source
      RouterDefinition.ml))))))

(executable
 (name round_trip)
 (modules Code Pages Router RouterRegistry Round_trip)
 (libraries
  js
  lwt
  lwt.unix
  server-reason-react.react
  server-reason-react.reactDom
  server-reason-react.router-native
  server-reason-react.rsc-native)
 (preprocess
  (per_module
   ((pps server-reason-react.ppx)
    Pages
    Router))))

(cram
 (deps round_trip.exe))
