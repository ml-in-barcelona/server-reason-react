(rule
 (targets Router.re RouterRegistry.re)
 (deps RouterDefinition.re)
 (action
  (progn
   (with-stdout-to
    Router.re
    (pipe-outputs
     (run %{bin:refmt} --parse re --print ml %{dep:RouterDefinition.re})
     (run
      %{bin:server-reason-react.router-gen}
      --mode
      handles
      --source
      %{dep:RouterDefinition.re})
     (run %{bin:refmt} --parse ml --print re)))
   (with-stdout-to
    RouterRegistry.re
    (pipe-outputs
     (run %{bin:refmt} --parse re --print ml %{dep:RouterDefinition.re})
     (run
      %{bin:server-reason-react.router-gen}
      --mode
      registry
      --source
      %{dep:RouterDefinition.re})
     (run %{bin:refmt} --parse ml --print re))))))

(test
 (name test_patterns)
 (modules Pages Router RouterRegistry Test_patterns)
 (libraries
  alcotest
  js
  lwt
  lwt.unix
  server-reason-react.react
  server-reason-react.reactDom
  server-reason-react.router-native)
 (preprocess
  (per_module
   ((pps server-reason-react.ppx)
    Pages
    Router
    Test_patterns))))
