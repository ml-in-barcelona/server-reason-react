(rule
 (targets Router.ml Router.mli RouterRegistry.ml)
 (deps Routes.ml)
 (action
  (progn
   (with-stdout-to
    Router.ml
    (with-stdin-from
     %{dep:Routes.ml}
     (run
      %{bin:server-reason-react.router-gen}
      --mode
      handles
      --source
      %{dep:Routes.ml})))
   (with-stdout-to
    Router.mli
    (with-stdin-from
     %{dep:Routes.ml}
     (run
      %{bin:server-reason-react.router-gen}
      --mode
      interface
      --source
      %{dep:Routes.ml})))
   (with-stdout-to
    RouterRegistry.ml
    (with-stdin-from
     %{dep:Routes.ml}
     (run
      %{bin:server-reason-react.router-gen}
      --mode
      registry
      --source
      %{dep:Routes.ml}))))))
